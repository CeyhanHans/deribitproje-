+def resolve_canonical_execution_model(model_identifier: Union[str, ExecutionModelId]) -> ExecutionModelId:
+    """Resolve an execution model identifier to a validated ExecutionModelId.
+
+    Raises ValidationError for unknown or ambiguous identifiers.
+    """
+    if isinstance(model_identifier, ExecutionModelId):
+        val = model_identifier.value
+    elif isinstance(model_identifier, str):
+        val = model_identifier.strip().lower()
+    else:
+        raise ValidationError(f"Invalid model identifier type: {type(model_identifier).__name__}")
+
+    if val in EXECUTION_MODEL_MIGRATION_TABLE:
+        return EXECUTION_MODEL_MIGRATION_TABLE[val]
+    raise ValidationError(
+        f"Unknown or ambiguous execution model identifier: '{model_identifier}'. "
+        f"Known models: {sorted(EXECUTION_MODEL_MIGRATION_TABLE.keys())}"
+    )
