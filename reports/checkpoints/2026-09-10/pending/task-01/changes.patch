+@dataclass(frozen=True)
+class TickScheduleStep:
+    """A single tier in a tick size schedule.
+
+    For price < threshold_price_btc, the minimum tick size is tick_size_btc.
+    """
+    threshold_price_btc: Decimal
+    tick_size_btc: Decimal
+
+    def __post_init__(self) -> None:
+        object.__setattr__(
+            self,
+            "threshold_price_btc",
+            validate_decimal(self.threshold_price_btc, "threshold_price_btc", strictly_positive=True),
+        )
+        object.__setattr__(
+            self,
+            "tick_size_btc",
+            validate_decimal(self.tick_size_btc, "tick_size_btc", strictly_positive=True),
+        )
+
+
+@dataclass(frozen=True)
+class TickSchedule:
+    """Ordered schedule of tick sizes based on price thresholds.
+
+    Invariants:
+    - Steps must be strictly ascending by threshold_price_btc (no overlapping or equal thresholds).
+    - Thresholds and tick sizes must be strictly positive.
+    - default_tick_size_btc applies when price >= highest step threshold.
+    """
+    steps: Tuple[TickScheduleStep, ...] = ()
+    default_tick_size_btc: Decimal = Decimal("0.0005")
+
+    def __post_init__(self) -> None:
+        object.__setattr__(
+            self,
+            "default_tick_size_btc",
+            validate_decimal(self.default_tick_size_btc, "default_tick_size_btc", strictly_positive=True),
+        )
+        prev_thresh = Decimal("0")
+        for i, step in enumerate(self.steps):
+            if not isinstance(step, TickScheduleStep):
+                raise ValidationError(f"Step {i} must be an instance of TickScheduleStep, got {type(step).__name__}")
+            if step.threshold_price_btc <= prev_thresh:
+                raise ValidationError(
+                    f"Tick schedule steps must be strictly ascending: step {i} threshold "
+                    f"{step.threshold_price_btc} <= previous threshold {prev_thresh}"
+                )
+            prev_thresh = step.threshold_price_btc
+
+    def get_tick_size(self, price_btc: Decimal) -> Decimal:
+        """Return the applicable tick size for a given price in BTC."""
+        price = validate_decimal(price_btc, "price_btc", non_negative=True)
+        for step in self.steps:
+            if price < step.threshold_price_btc:
+                return step.tick_size_btc
+        return self.default_tick_size_btc
+
+
