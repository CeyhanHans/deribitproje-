+    def test_standard_library_only(self) -> None:
+        """Verify that core/contracts.py only imports standard library modules."""
+        imported_modules = inspect.getmembers(cc, inspect.ismodule)
+        stdlib_names = {
+            "annotations",
+            "dataclasses",
+            "datetime",
+            "decimal",
+            "enum",
+            "hashlib",
+            "inspect",
+            "json",
+            "math",
+            "pathlib",
