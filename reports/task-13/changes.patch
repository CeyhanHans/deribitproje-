+        self.assertEqual(t2.realized_pnl_btc, Decimal("-0.0306"))
+        self.assertEqual(t3.realized_pnl_btc, Decimal("0.0194"))
+        self.assertEqual(result.metrics.net_pnl_btc, Decimal("0.0182"))
+
