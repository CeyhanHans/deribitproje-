+    # --------------------------------------------------------------------------
+    # 7. Fee Charged Strictly Once Per Fill
+    # --------------------------------------------------------------------------
+    def test_fee_single_charge(self) -> None:
+        """Every fill in the event loop charges fee exactly once on the ledger."""
+        t0 = 1711700000000
+        config = RunConfig(
